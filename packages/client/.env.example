# Copy to packages/client/.env before `pnpm build`. Vite bakes these into the bundle at build time,
# so they are public values (no secrets here). Leave all three unset to run without sign-in (local dev).
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-spa-client-id
VITE_AUTH0_AUDIENCE=https://modularcircuits-api
