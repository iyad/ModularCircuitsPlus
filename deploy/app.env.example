# Copy to /home/iyad/site-deploy/bits-and-gates/.env (next to compose.yml). No secrets here:
# the client id, domain and audience are public values baked into the browser bundle.

# Auth0 tenant domain, and the SPA application's Client ID (Applications > Applications).
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-spa-client-id

# Identifier of the Auth0 API (Applications > APIs).
AUTH0_AUDIENCE=https://modularcircuits-api

# Optional, comma-separated Auth0 user ids allowed to edit the shared starter library,
# e.g. google-oauth2|1234567890 (User Management > Users in the Auth0 dashboard).
ADMIN_USER_IDS=
