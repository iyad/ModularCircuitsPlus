[Unit]
Description=Bits & Gates (bitsandgates.com) server
After=network.target

[Service]
Type=simple
User=modularcircuits
WorkingDirectory=/opt/modularcircuits
EnvironmentFile=/etc/modularcircuits/server.env
ExecStart=/usr/bin/node packages/server/dist/index.js
Restart=on-failure
RestartSec=5

# Hardening: the app only needs to write its database directory.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/modularcircuits

[Install]
WantedBy=multi-user.target
