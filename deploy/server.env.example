# Copy to /etc/modularcircuits/server.env on the VPS (referenced by modularcircuits.service).
NODE_ENV=production
PORT=3001

# Live database, kept outside the git checkout so deploys never overwrite it.
DB_PATH=/var/lib/modularcircuits/circuits.db

# Must match the Auth0 API you create (Applications > APIs). Same values as the client's VITE_AUTH0_DOMAIN / VITE_AUTH0_AUDIENCE.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://modularcircuits-api

# Optional, comma-separated Auth0 user ids allowed to edit the shared starter library,
# e.g. google-oauth2|1234567890. Find yours under User Management > Users in the Auth0 dashboard.
ADMIN_USER_IDS=
